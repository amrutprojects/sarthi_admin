# Base URL of the backend API. Development: /api/v1 (Vite proxies /api to VITE_API_PROXY_TARGET).
# Staging/production: the API origin, e.g. https://api.example.gov.in/api/v1 (must be the same site as the panel for the session cookie, ADR-0003).
VITE_API_BASE_URL=/api/v1
# Backend origin the Vite dev server proxies /api to (development only)
VITE_API_PROXY_TARGET=http://localhost:5001
# Where the existing public website is served (links to Track / Verify open it)
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5173/index.html

# Base URL of the backend API. Development: /api/v1 (Vite proxies /api to VITE_API_PROXY_TARGET).
# Staging/production: preferably /api/v1 too, with the panel's own web server proxying /api/ to the API (same origin: no CORS
# preflight, and nothing a browser's privacy protection such as Brave Shields or an ad blocker treats as another site).
# Otherwise the API origin, e.g. https://api.example.gov.in/api/v1 (must be the same site as the panel for the session cookie,
# ADR-0003, and the panel's origin must be in the API's FRONTEND_URL).
VITE_API_BASE_URL=/api/v1
# Backend origin the Vite dev server proxies /api to (development only)
VITE_API_PROXY_TARGET=http://localhost:5001
# Where the existing public website is served (links to Track / Verify open it)
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5173/index.html

# Base URL of the backend API (not used yet: the prototype has no backend; data comes from src/legacy/data.js)
VITE_API_BASE_URL=/api/v1
# Where the existing public website is served (links to Home / Track / Verify open it)
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5173/index.html
# Backend origin the Vite dev server proxies /api to
VITE_API_PROXY_TARGET=http://localhost:5001
